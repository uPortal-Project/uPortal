<!--
    RDBMUserLayoutStoreConcurrencyTest's context: the portal database and its JPA transaction
    manager, which the layout store's JDBC transactions run under in the portal.

    The test runs on an HSQLDB database of its own with MVCC transactions, as uPortal-start's
    HSQLDB server runs.

    The connections default to SERIALIZABLE (8), so a save that doesn't ask for READ COMMITTED
    itself shows up on HSQLDB as it does on MariaDB 11.6 and later.
-->
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.1.xsd">

    <bean id="localPropertyPlaceholderConfigurer" parent="propertyPlaceholderConfigurer" class="org.springframework.beans.factory.config.PropertyPlaceholderConfigurer">
        <property name="properties">
            <props>
                <prop key="persistenceUnitName">PortalDb</prop>
            </props>
        </property>
    </bean>

    <bean id="transactionManager" class="org.springframework.orm.jpa.JpaTransactionManager">
        <qualifier value="PortalDb" />
        <property name="entityManagerFactory" ref="factoryBean" />
    </bean>

    <bean id="transactionOperations" class="org.springframework.transaction.support.TransactionTemplate">
        <qualifier value="PortalDb"/>
        <property name="transactionManager" ref="transactionManager" />
    </bean>

    <bean id="PortalDb" parent="TestDb">
        <qualifier value="PortalDb" />
        <property name="url" value="jdbc:hsqldb:mem:rdbmUserLayoutStoreTest;hsqldb.tx=mvcc" />
        <property name="defaultTransactionIsolation" value="8" />
    </bean>

    <import resource="classpath:sharedJpaTestContext.xml"/>
</beans>
